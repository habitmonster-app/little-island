 },
 "voyage": {
  "base_minutes": 12,
  "base_seconds": 720,
  "port_distance_source": "03_ports.json ports.distance",
  "speed_source": "02_ships.json ships.speed",
  "duration_formula": "ceil(base_seconds * port.distance / ship.speed)",
  "event_fractions": {
   "pirate_without_specialty": 0.2361111111111111,
   "pirate_with_specialty": 0.75,
   "port_arrive": 0.4166666666666667,
   "port_leave": 0.5833333333333334,
   "return": 1
  },
  "minimum_duration_seconds": 480,
  "maximum_duration_seconds": 1800,
  "clamp_after_formula": true,
  "note": "출시안은 해솔항 왕복부터 시작하고 먼 항구와 큰 배에 따라 시간이 달라진다. 사용자 확인 없이 자동으로 왕복을 이어 간다.",
  "auto_repeat": true,
  "route_changes_apply": "next_departure",
  "automatic_partial_load": true,
  "empty_departure_allowed": false,
  "no_materials": "wait_for_at_least_one_wood; retry_on_resource_change",
  "manifest_snapshot": [
   "ship_level",
   "ship_speed",
   "port_id",
   "distance",
   "cargo",
   "pirate_stats",
   "worker_bonuses",
   "building_bonuses",
   "sale_prices",
   "specialty_cost",
   "specialty_buyer_port"
  ],
  "base_cargo_payout": "at_port_sale_once",
  "specialty_payout": "at_home_return_once",
  "combat_reward_payout": "at_return_once; outcome recorded at encounter"
 },
 "specialty_trade": {
  "enabled_after": "ship_2",
  "quantity_max_source": "ships.cargo_special",
  "source_port_must_equal_selected_voyage_port": true,
  "buyer_port_must_be_unlocked": true,
  "source_port_must_be_unlocked": true,
  "source_and_buyer_must_differ": true,
  "purchase_price_source": "ports[source].sells[resource]",
  "resale_price_source": "ports[buyer].buys[resource]",
  "purchase_payment": "prepaid_fixed_price_contract_at_departure",
  "sale_payment": "surviving_special_cargo_on_return",
  "quantity_is_integer": true,
  "quantity_affordable": "floor(spendable_gold / unit_purchase_price)",
  "logistics": "방문항에서 예약한 특산물을 싣고 돌아오면 작은 섬에 온 계약 수령선에 인도한다. buyer_port는 그 수령선의 소속 항구다. 수령선이 다음 운송을 맡으므로 플레이어 배의 추가 항해나 영구 재고가 생기지 않는다.",
  "cost_paid_even_if_lost": true,
  "loss_applies_only_to_current_onboard_cargo": true,
  "outbound_non_specialty_loss_targets": [
   "wood",
   "stone"
  ],
  "inbound_specialty_loss_targets": [
   "specialty_cargo"
  ],
  "sold_base_cargo_never_recomputed": true,
  "no_free_specialty_from_supply": true,
  "settlement_does_not_duplicate_gold": true,
  "spendable_gold_formula": "max(0, min(wallet_gold - reserve_gold, wallet_gold * specialty_spend_limit_fraction))"
 },
 "money": {
  "internal_unit": "gold_cent",
  "units_per_gold": 100,
  "price_rounding": "convert_table_price_to_integer_cents_once",
  "settlement_rounding": "floor_to_cent_after_combining_additive_bonuses",
  "display_rounding": "floor_to_whole_gold_with_hidden_remainder_preserved",
  "building_and_upgrade_costs": "integer_gold",
  "trade_effect_modifier": "1 + (market_multiplier - 1) + capped_worker_sale_bonus",
  "worker_sale_bonus_cap": 0.06,
  "worker_combat_bonus_cap": 0.02,
  "minimum_wallet": 0
 },
