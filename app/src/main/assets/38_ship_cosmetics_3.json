  },
  "condition_contract": {
    "evaluation": "all_of의 모든 구조화 조건을 판정한다. how_to_get과 how_to_get_text는 짧은 안내일 뿐이며, 수치·진행·가격은 앱이 별도로 표시한다.",
    "allowed_types": [
      "boss_first_win",
      "souvenir_milestone_complete",
      "game_flag",
      "counter_at_least",
      "any_promoted_crew_level_at_least"
    ],
    "boss_first_win": {
      "source": "25·39가 함께 쓰는 boss_first_win_ids와 첫승 정산 장부",
      "comparison": "해당 boss_id의 첫 승리 귀항 정산이 확정됨",
      "required_boss_ids": [
        "boss_coral_seahorse",
        "boss_cobalt_flyingfish",
        "boss_burgundy_lantern",
        "boss_mint_turtle"
      ],
      "story_read_required": false
    },
    "souvenir_milestone_complete": {
      "source": "26의 기존 milestones.id별 완료·보상 정산 장부",
      "comparison": "해당 milestone_id의 완료 정산이 확정됨",
      "required_milestone_ids": [
        "souvenir_count_20",
        "souvenir_count_30",
        "souvenir_all_ports"
      ],
      "no_new_milestones": true,
      "story_read_required": false
    },
    "game_flag": {
      "source": "기존 배 승급 완료 플래그",
      "comparison": "ship_5 완료 및 현재 배 단계가5 이상",
      "known_keys_used": [
        "ship_5"
      ],
      "story_read_required": false
    },
    "counter_at_least": {
      "source": "기존 영구 누적 통계",
      "known_counters": [
        "voyages",
        "treasures"
      ],
      "voyages": "실제 정상 귀항 정산 횟수. 일반·특별 항해가 포함되며 같은 귀항은한번만 센다.",
      "treasures": "기존 보물 찾기의 성공 정산 횟수. 지도 조각 획득·상자 연출·우두머리 첫승·카드 열기는 보물 성공이 아니다.",
      "comparison": "저장된 누적값 >= value",
      "no_daily_reset": true
    },
    "any_promoted_crew_level_at_least": {
      "source": "20·30의 승진한 영구 고용 선원 목록과 현재 레벨",
      "comparison": "승진 선원 중 한 명이라도 level >= value. 승선 중일 필요는 없다.",
      "not_island_worker_level": true
    },
    "same_transaction": "첫승·기념품 이정표·귀항 통계·보물 성공·승급이 확정되는 같은 트랜잭션의 새 상태로 조건을 확인하고 미소장 장식을 한 번 추가한다. 아직 저장 전인 플래그를 따로 재조회해 지급을 놓치지 않는다."
  },
  "acquisition_rules": {
    "automatic_grant": "첫승·이정표·누적 기록·선원 성장·배 승급 조건을 만족한 미소장 항목을 한 번 소장한다. 자동 장착하거나 원래 이벤트의 금화·지도 조각 보상을 재실행하지 않는다.",
    "manual_purchase": "배5 조건·미소장·잔액을 확인하고 사용자가 구매를 눌렀을 때만 cost.gold를 차감한다. 네 항목은 각각10000·16000·22000·30000금화이며 확률 구매가 아니다.",
    "gold_unit": "cost.gold는 정수 게임 금화이며 wallet cents에서는 cost.gold * 100을 차감한다.",
    "real_money_purchase": false,
    "insufficient_gold": "잔액과 소장 목록을 그대로 유지한다.",
    "no_auto_spending": true,
    "repeat_purchase_of_owned_item": "이미 소장한 ID는 다시 차감하지 않는다.",
    "duplicate_grant": "이미 소장했으면 추가 금화·쪽지·자원·장식으로 교환하지 않는다.",
    "idempotency_key": "save_id + cosmetic_item_id",
    "ownership_write_is_atomic": true,
    "no_random_loot": true,
    "no_time_limited_loss": true,
    "free_items_purchase_price": null,
    "reevaluate_after": [
      "boss_first_win_settlement",
      "souvenir_milestone_settlement",
      "voyage_return_settlement",
      "treasure_success_settlement",
      "promoted_crew_level_up",
      "ship_stage_upgrade",
