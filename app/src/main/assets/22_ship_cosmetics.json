  "acquisition_rules": {
    "automatic_grant": "조건을 충족한 무료 장식은 첫 출항·귀항·배 단계 승급·선원 성장·항구 및 시설 해금 정산 후 소장 목록에 한 번 추가한다. 별도 접속 시간이나 이야기 읽음을 요구하지 않는다.",
    "manual_purchase": "조건을 충족한 유료 장식은 앱의 구매 확인 후에만 구입한다. 잔액과 미소장 상태를 다시 확인하고 금화 차감과 소장을 하나의 저장 트랜잭션으로 확정한다.",
    "gold_unit": "cost.gold는 정수 금화이며 wallet cents에서는 cost.gold * 100을 차감한다.",
    "insufficient_gold": "소장 목록과 잔액을 모두 유지한다. 음수 잔액이나 자동 빚을 만들지 않는다.",
    "no_auto_spending": true,
    "repeat_purchase_of_owned_item": "이미 소장한 장식은 다시 차감하지 않고 소장 상태를 유지한다.",
    "duplicate_grant": "이미 소장했으면 아무 보상도 추가하지 않는다. 중복 금화·자원으로 바꾸지 않는다.",
    "idempotency_key": "save_id + cosmetic_item_id",
    "ownership_write_is_atomic": true,
    "no_random_loot": true,
    "no_time_limited_loss": true,
    "free_items_purchase_price": null,
    "reevaluate_after": [
      "first_departure",
      "voyage_settlement",
      "ship_stage_upgrade",
      "crew_promotion_or_levelup",
      "port_unlock",
      "building_unlock",
      "save_migration"
    ]
  },
  "offline_and_migration": {
    "progress_source": "기존 최대 8시간 부재 보상 계산에서 실제 정산된 voyages/treasures 및 20_crew.json 규칙으로 지급된 선원 경험치 결과만 사용한다.",
    "not_based_on": "접속하지 않은 전체 실시간, 결과 카드 조회 횟수, 이야기 조회 횟수",
    "existing_save": "처음 연결할 때 기존 카운터·완료 플래그·승진 선원 레벨로 무료 조건을 재평가하고 미소장 항목만 한 번 지급한다.",
    "existing_ownership": "이미 소장하고 장착한 항목은 유지한다. 과거 조건을 충족했다는 이유로 유료 항목을 자동 구매하지 않는다.",
    "unsupported_item_id": "알 수 없는 저장 ID는 소장 기록에서 보존하되 그리기를 생략한다. 지원되는 장식으로 임의 변경하거나 비용을 청구하지 않는다.",
