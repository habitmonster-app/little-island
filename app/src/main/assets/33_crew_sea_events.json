  "schema_version": 1,
  "design_status": "order10_data_proposal_v1",
  "selection_rules": {
    "roll_scope": "항해 전체에 한 번. 선원마다 25%씩 검사하지 않는다.",
    "max_events_per_voyage": 1,
    "when": "출항 명단·레벨·항해 ID를 저장하는 같은 트랜잭션에서 선택 결과도 저장한다.",
    "eligible_crew": "출항 스냅샷에 실제 승선한 승진 선원 중 min_crew_level을 충족하는 사건이 하나 이상 있는 고유 crew ID. 대기 선원·섬 견습선원·서린·주민은 제외한다.",
    "eligible_events": "선택된 crew가 일치하고 출항 당시 레벨 >= min_crew_level인 사건. Lv10이면 그 선원의 Lv1·Lv5·Lv10 사건이 모두 후보이다.",
    "selection_order": [
      "적격 선원이 없으면 사건 없음으로 저장하고 종료한다.",
      "전용 난수 스트림에서 chance_per_voyage=0.25로 한 번 검사한다. 실패도 사건 없음으로 저장한다.",
      "적격 crew ID를 정렬한 목록에서 균등하게 한 명 고른다.",
      "그 선원의 적격 event ID를 정렬한 목록에서 균등하게 하나 고른다."
    ],
    "seed_namespace": "save_id + voyage_sequence + crew_sea_event_v1",
    "save_snapshot": [
      "event_id_or_null",
      "crew_id",
      "departure_crew_level",
      "effect_kind",
      "effect_value",
      "cue_at_voyage_elapsed_seconds",
      "cue_consumed",
      "reward_settled"
    ],
    "changes_after_departure": "진행 중 항해의 명단·레벨·사건·보상은 다시 계산하지 않는다. 뒤늦은 승급·선원 교체는 다음 출항부터 적용한다.",
    "level_15_or_full_inventory": "후보에서 빼거나 다른 보상으로 다시 뽑지 않는다. 레벨 상한·창고 초과는 지급 규칙으로 처리한다.",
    "none_is_a_real_event": true,
    "no_repeat_reroll": "같은 사건이 연속으로 나와도 다시 뽑지 않는다. 화면 열기·일시 정지·앱 재실행은 선택에 영향을 주지 않는다.",
    "existing_random_streams_unchanged": true,
    "chance_bonuses": "20·28·30의 event_good_bonus·treasure_find_bonus·키 부품 보너스는 기존07 사건에만 적용한다. 이 파일의 고정25%나 효과량에는 더하거나 곱하지 않는다."
  },
  "timing_and_emote_rules": {
    "cue_fraction_of_final_voyage_duration": 0.65,
    "cue_time": "출항 시 고정한 실제 최종 항해 시간의 65% 지점(초 단위 내림). 특별 항해도 실제 최종 시간을 사용하며 이동 속도나 이벤트 시각 자체는 바꾸지 않는다.",
    "cue_is_visual_only": true,
    "emote_duration_ms": 1800,
    "attachment": "해당 항해 스냅샷의 event.crew 캐릭터 머리 위. 말풍선 꼬리의 아래 중앙을 기준점에 맞춘다.",
    "play_once": "실시간으로 cue 시각을 지날 때 cue_consumed를 먼저 저장하고 화면에 해당 선원이 보이는 경우만 잠깐 표시한다. 재접속·화면 복원·뒤늦은 읽기로 재생하지 않는다.",
    "busy_or_hidden_screen": "전투·이야기·다른 카드가 화면을 가리거나 홈이 보이지 않으면 이번 연출만 건너뛴다. 나중에 몰아 재생하거나 이미 내려간 선원의 머리 위에 표시하지 않는다.",
    "offline": "오프라인 시뮬레이션이 cue를 지나면 소비 표시만 한다. 복귀 때 과거 말풍선을 줄줄이 재생하지 않는다.",
    "reward_timing": "말풍선이 뜨는 시점에는 재화·경험치를 지급하지 않는다. 귀항 정산에서 카드와 효과를 함께 확정한다.",
    "partial_voyage": "미완료 항해에는 카드·보상을 지급하지 않고 스냅샷·남은 시간·cue_consumed 상태를 유지한다."
  },
  "settlement_rules": {
    "settle_at": "인정되는 정상 귀항 정산. 일반 항해와 특별 항해에 동일 적용하며 일반 해적 전투의 승패는 조건이 아니다.",
    "once_key": "save_id + voyage_sequence + crew_sea_event_reward",
    "atomic_commit": [
      "정상 귀항 정산 장부",
      "선택된 사건 또는 사건 없음 결과",
      "사건 효과 지급 내역",
      "자원 초과 미지급 잔량",
      "사건 카드 표시용 결과",
      "reward_settled"
    ],
    "retry": "확정 전 중단은 저장된 사건·효과로 트랜잭션을 재개한다. 확정 뒤 재실행은 기존 결과를 읽고 재지급하지 않는다.",
    "none": "kind=none은 value=0이며 말풍선과 귀항 카드만 표시한다. 별도 대체 보상은 없다.",
    "gold": "value는 정수 금화이며 지갑의 최소 단위에는 value*100을 더한다. 화물 판매액을 수정하거나 거래표 전체를 다시 정산하지 않는다.",
    "wood_stone": "고정 추가 보상으로 창고에 직접 지급한다. 실은 화물을 가져오거나 기존 재고에서 빼는 연산이 아니며 화물 적재량·판매량·해적 손실량에 넣지 않는다. 카드의 발견·절약 묘사는 보상 연출이다.",
    "resource_overflow": "실제 창고에 들어간 수량과 초과분을 해당 사건 보상 장부에 나누어 저장한다. 초과분은 기한 없는 미지급 잔량으로 두고 여유가 생길 때 잔량을 차감하는 동일 트랜잭션으로 지급한다. 창고 상한을 늘리거나 초과분을 다른 재화로 환전하지 않는다.",
    "tickets": "value는 기존 voyage_note 쪽지 수량이다. 훈련·주문 성공이나 부적 뽑기 횟수로 계산하지 않는다.",
    "crew_xp": "event.crew 한 명에게만 value를 추가한다. 출항 명단 전원의 정규 항해XP10 및 특별 항해 최초 보너스와 구분한 장부 키를 쓰며 각각 한 번만 처리한다.",
    "xp_order": "정규 귀항XP, 특별 항해XP가 있으면 그 보너스, 마지막으로 이 사건XP를 30의 같은 승급 함수로 정산한다. 지급 시점의 실제 저장 레벨을 사용하며 선택 조건만 출항 레벨이다.",
    "xp_cap": "30_crew_levels_2.json의 최대Lv15·구간별 차감 규칙을 사용한다. Lv1~9 비용은20, Lv10~14 비용은30.xp_to_next_11_15[level-10]. Lv15 도달 후 잔량은0이며 이미Lv15이면 이 보너스도 저장·환전하지 않는다.",
    "new_skills": "사건XP로 연 스킬은 다음 출항부터 적용한다. 끝난 항해를 다시 계산하지 않는다.",
    "no_multipliers": "이 파일의 고정 효과에 판매·시장·선원·부적·좋은 사건·특산물 배율을 적용하지 않는다.",
    "cards_are_read_only": "귀항 카드 열기·배지 누르기·다시 보기·연출 완료로 효과를 지급하지 않는다.",
