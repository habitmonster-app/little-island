  "equipment_rules": {
    "max_level": 5,
    "initial_owned_level": 1,
    "feature_unlock": {
      "at_least_one_promoted_crew": true
    },
    "per_crew": 1,
    "per_charm_id_equipped_crew": 1,
    "ownership": "one_per_id_with_shared_upgrade_level",
    "only_owned_charms": true,
    "only_promoted_crew": true,
    "seorin_equippable": false,
    "move_between_crew": "다른 선원이 단 부적을 옮기면 이전 선원에서 해제하고 새 선원에 다는 변경을 한 번에 저장한다. 같은 ID의 부적 두 개를 만들지 않는다.",
    "occupied_target_slot": "새 부적을 달면 그 선원의 이전 부적은 소장 목록에 남고 장착만 해제된다.",
    "allow_unequip": true,
    "equip_cost": 0,
    "unequip_cost": 0,
    "bench_effects": 0,
    "unpromoted_worker_effects": 0,
    "automatic_equip_on_draw": false,
    "changes_apply": "next_departure",
    "in_flight": "출항 시 부적 ID·레벨·착용자·역할 배율·합산 효과를 고정한다. 이후 획득·중복 성장·교체로 진행 중 항해를 다시 계산하지 않는다.",
    "crew_skills_unchanged": true,
    "crew_xp_unchanged": true,
    "no_charm_consumption": true
  },
  "effect_caps": {
    "cargo_bonus": 0.35,
    "speed_bonus": 0.15,
    "pirate_win_bonus": 0.1,
    "sale_bonus": 0.15,
    "event_good_bonus": 0.1,
    "repair_after_loss": 0.35,
    "treasure_find_bonus": 0.1,
    "wood_price_bonus": 0.1,
    "stone_price_bonus": 0.1
  },
  "effect_rules": {
    "allowed_effects": [
      "cargo_bonus",
      "speed_bonus",
      "pirate_win_bonus",
      "sale_bonus",
      "event_good_bonus",
      "repair_after_loss",
      "treasure_find_bonus",
      "wood_price_bonus",
      "stone_price_bonus"
    ],
    "value_semantics": "value_by_level[level-1]은 그 단계의 총 효과다. 1단계부터 현재까지의 값을 더하지 않는다.",
    "probability_effects": [
      "pirate_win_bonus",
      "event_good_bonus",
      "treasure_find_bonus"
    ],
    "probability_unit": "0.01 = 1%p. 나머지 효과는 기존 20_crew.json의 상대 비율 의미를 따른다.",
    "role_multiplier": 1.5,
    "role_multiplier_fraction": {
      "numerator": 3,
      "denominator": 2
    },
    "role_match": "착용한 선원의 현재 crew_role이 best_for_role과 정확히 같으면 1.5배, 아니면 1배. best_for_worker_ids는 현재 12명 기준의 대응표다.",
    "arithmetic_unit": "1 ppm = 0.000001. value_ppm_by_level과 정수 역할 배율 3/2로 계산하고 합산까지 보관한다. 표시 반올림을 효과 계산에 재사용하지 않는다.",
    "aggregation_order": [
      "출항 명단 선원들의 해금 스킬을 effect별로 합산한다.",
      "같은 명단의 활성 짝 보너스를 effect별로 한 번 합산한다.",
      "같은 명단의 착용 부적 총 효과에 착용자의 역할 배율을 곱해 effect별로 더한다.",
      "스킬·짝·부적 합계에 기존 effect_caps를 한 번 적용한다.",
      "19_ship_parts.json의 계산 규칙으로 부품·배·건물·현재 섬 알바 효과와 결합하고 기존 최종 상한을 유지한다."
    ],
    "formula": "capped_crew[effect] = min(effect_caps[effect], unlocked_skill_sum[effect] + active_synergy_sum[effect] + aboard_charm_sum[effect])",
    "charms_have_no_separate_cap_pool": true,
    "max_aboard_charms": 6,
    "sale_scope": "실제 판매한 화물 대금만. 일반 및 우두머리 전투 보상, 첫 승리 보상, 임무·도감·퍼즐 보상, 금화 환급에는 곱하지 않는다.",
