  },
  "condition_contract": {
    "evaluation": "all_of의 모든 조건을 충족해야 한다. how_to_get은 표시용 요약, how_to_get_text는 화면 문구이며 판정은 구조화 조건을 사용한다.",
    "boss_first_win": {
      "source": "25_pirate_bosses.json의 boss.id별 첫 승리 정산 장부",
      "comparison": "해당 boss_id의 첫 승리가 확정됨",
      "story_read_required": false,
      "generic_pirate_win_count_is_not_enough": true
    },
    "souvenir_milestone_complete": {
      "source": "26_souvenirs.json의 milestones.id별 완료·보상 정산 장부",
      "comparison": "해당 milestone_id의 조건 달성과 첫 정산이 확정됨",
      "required_milestone_ids": [
        "souvenir_all_ports",
        "souvenir_count_15",
        "souvenir_count_25",
        "souvenir_count_33"
      ],
      "story_read_required": false
    },
    "game_flag": {
      "source": "배 5단계 승급 완료 상태",
      "comparison": "ship_5가 완료이며 현재 배 단계가 5 이상",
      "known_keys_used": [
        "ship_5"
      ],
      "story_read_required": false
    },
    "reward_condition_note": "보상 정산 중에는 첫 승리·이정표 완료를 저장하는 동일 트랜잭션 안에서 장식 소장을 추가한다. 아직 저장하지 않은 플래그를 따로 다시 읽는 순환 판정으로 지급을 막지 않는다."
  },
  "acquisition_rules": {
    "automatic_grant": "우두머리 첫 승리 또는 도감 이정표의 원래 보상 트랜잭션에서 해당 cosmetic_id를 소장 목록에 한 번 추가한다.",
    "manual_purchase": "배 5단계 조건·잔액·미소장을 확인하고 사용자가 구매를 누른 경우에만 금화 차감과 소장을 하나의 트랜잭션으로 확정한다.",
    "gold_unit": "cost.gold는 정수 게임 금화이며 wallet cents에서는 cost.gold * 100을 차감한다.",
    "real_money_purchase": false,
    "insufficient_gold": "잔액과 소장 목록을 그대로 유지한다.",
    "no_auto_spending": true,
    "repeat_purchase_of_owned_item": "이미 소장한 ID는 다시 차감하지 않는다.",
    "duplicate_grant": "이미 소장했으면 추가 금화·쪽지·자원·장식으로 교환하지 않는다.",
    "idempotency_key": "save_id + cosmetic_item_id",
    "ownership_write_is_atomic": true,
    "no_random_loot": true,
    "no_time_limited_loss": true,
    "free_items_purchase_price": null,
    "reevaluate_after": [
      "boss_first_win_settlement",
      "souvenir_milestone_settlement",
      "ship_stage_upgrade",
      "save_migration"
    ],
    "source_rewards_own_the_payout": "25의 first_win_reward와 26의 reward가 정산 주체다. 27은 장식 정의와 획득 조건만 제공하며 그 금화·지도 조각 보상을 다시 지급하지 않는다.",
    "recovery": "원본 첫 승리·이정표 정산은 완료됐지만 장식만 누락됐으면 같은 cosmetic_id의 소장만 복구한다. 원본 보상 정산을 재실행하지 않는다."
  },
  "offline_and_migration": {
    "progress_source": "기존 최대 8시간 인정 구간에서 실제 확정한 우두머리 첫 승리·도감 수집과 이정표 장부만 사용한다.",
    "not_based_on": "앱을 닫아 둔 전체 실시간, 일반 해적 누적 승리, 결과 카드 열기, 이야기 다시 보기",
    "existing_save": "기존 22의 소장·장착 기록을 유지하고 27의 신규 ID 16개를 같은 목록에 추가한다. 과거 보통 해적 승리를 새 우두머리 승리로 간주하지 않는다.",
    "existing_ownership": "같은 ID의 소장은 유지한다. 배 5단계가 됐다고 유료 장식을 자동 구매하지 않는다.",
    "unsupported_item_id": "알 수 없는 저장 ID는 보존하되 그리기를 생략한다. 다른 장식으로 바꾸거나 비용을 청구하지 않는다.",
    "save_fields": [
      "owned_cosmetic_ids",
      "equipped_cosmetics_by_slot",
      "cosmetic_grant_ledger"
    ],
    "merge_key": "item.id",
    "combined_item_count": 32,
    "same_slot_across_both_sets": true,
    "reset_equipment_on_import": false
