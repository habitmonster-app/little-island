    "never_retroactively_recalculate_rewards": true,
    "effect_preview": "현재 편성 기준 실제 전후 값과 상한을 표시한다. 상한으로 실제 효과가 늘지 않는 강화는 증가한다고 표시하지 않는다."
  },
  "cap_explanations": {
    "unchanged": "effect_rules와 crew_effect_caps는 기존 19/20 파일 값을 그대로 복사했다. 새 단계에서도 합산 순서와 모든 상한을 바꾸지 않는다.",
    "hull": "Lv25의 선체 단독 값은 1.25다. 선원/짝 보너스 합산 뒤 기존 1.35 상한을 적용하므로 화물형 편성에서는 일부 상승분이 상한에 걸릴 수 있다.",
    "sail": "Lv25 돛은 0.25이며 선원 합산 0.35 및 왕복 480~1800초 제한을 유지한다. 짧은 항로는 이미 최소 시간일 수 있다.",
    "cannon": "Lv25 대포 단독 승률 가산은 0.10이다. 최종 해적 승률은 기존 0.35~0.97 범위이고 강한 해적의 power 감산도 유지한다.",
    "helm": {
      "stat_value_unchanged_from_level": 20,
      "levels": [
        21,
        22,
        23,
        24,
        25
      ],
      "event_good_bonus": 0.05,
      "bad_event_loss_reduction": 0.1,
      "reason": "키는 Lv20에서 기존 개별 상한에 이미 도달한다. 21~25에서 상한이나 효과 종류를 추가하지 않는다.",
      "upgrade_kind": "optional_visual_maintenance",
      "player_notice": "키 효과는 이미 최대예요. 이후 정비는 레벨과 외형 진행만 올려요.",
      "numeric_effect_increase": false,
      "required_for_any_mission": false,
      "required_for_story_ending": false,
      "required_for_stage5_unlock_above_level20": false,
      "required_for_final_look": false,
      "final_look_alternative": "선체·돛·대포를 각각 23 이상으로 올리면 키 20을 유지해도 마지막 외형인 3열에 도달한다.",
      "purchase_optional": true,
      "do_not_label_as_combat_upgrade": true
    }
  },
  "merge_contract": {
    "mode": "additive_by_stable_id",
    "targets": [
      {
        "file": "02_ships.json",
        "action": "append ships entry where level=5; preserve entries 1..4"
      },
      {
        "file": "01_economy.json",
        "action": "append economy_progression_append by unlock=ship_5; keep all prior progression values"
      },
      {
        "file": "19_ship_parts.json",
        "action": "append each parts[id].levels 21..25; set max_level=25; merge max_level_per_ship_level, ship_upgrade_needs_parts_level, and look_stages_patch"
      },
      {
        "file": "20_crew.json",
        "action": "merge slots_by_ship_level; retain all crew values, caps and event_selection_adapter; update max_active_synergies_with_6_slots to 3"
      }
    ],
    "no_duplicate_append": "일치하는 level 또는 unlock 또는 (part_id, level)이 이미 있으면 동일한 값은 재추가하지 않는다. 다른 값이면 기존 파일을 조용히 덮지 않고 통합 시 비교한다.",
    "old_values_unchanged": "배 1~4단계, 부품 1~20레벨, 선원 스킬·경험치·계약·임무·기존 해금은 수정하지 않는다.",
    "effect_rule_reuse": "새 상한을 만들지 않고 이 파일의 effect_rules가 기존 19와 같은지 확인한 뒤 기존 계산기를 재사용한다.",
    "requires_parts_mapping": "ships[0].upgrade_requires_parts, ship_upgrade_needs_parts_level[5], economy_progression_append.requires_parts_at_least는 같은 전제의 세 표기다. 비용은 세 번이 아니라 하나의 승급 작업에서 한 번만 차감한다.",
