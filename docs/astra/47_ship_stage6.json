  "effect_rules": {
    "units": "0.05 means 5%; probability bonuses are additive probability points, 0.01 = 1%p",
    "source_of_crew_caps": "20_crew.json.effect_caps; the caps include pair synergies",
    "cargo_bonus": {
      "scope": [
        "cargo_wood",
        "cargo_stone",
        "cargo_special"
      ],
      "combined_cap": 1.35,
      "formula": "floor(base_capacity * (1 + min(1.35, hull.value + capped_crew.cargo_bonus)))",
      "zero_base_stays_zero": true,
      "never_creates_free_cargo": true,
      "load_after_capacity": "실제 보유량·특산물 예산·해금 조건 안에서만 적재한다."
    },
    "speed_bonus": {
      "meaning": "왕복 시간 감소율",
      "combined_cap": 0.35,
      "formula": "clamp(ceil(base_seconds * port.distance / ship.speed * (1 - min(0.35, sail.value + capped_crew.speed_bonus))), 480, 1800)",
      "minimum_duration_seconds": 480,
      "maximum_duration_seconds": 1800,
      "event_times": "최종 왕복 시간에 기존 event_fractions를 곱한다.",
      "minimum_tooltip": "이 항로는 최소 항해 시간에 도달했어요."
    },
    "pirate_win_bonus": {
      "formula": "clamp(ship.pirate_win - 0.1 * (pirate.power - 1) + lighthouse_bonus + capped_active_island_worker_bonus + cannon.value + capped_crew.pirate_win_bonus, 0.35, 0.97)",
      "island_worker_cap": 0.02,
      "lighthouse_bonus": 0.03,
      "minimum": 0.35,
      "maximum": 0.97,
      "changes_encounter_probability": false,
      "story_fixed_fights_affected": false
    },
    "event_good_bonus": {
      "adapter": "20_crew.json.event_selection_adapter",
      "scope": "적격 보상 사건이 있을 때, 항해 한 번당 좋은 사건 확률에 더하는 확률값",
      "part_max": 0.05,
      "does_not_change_event_reward_amount": true
    },
    "bad_event_loss_reduction": {
      "meaning": "나쁜 항해 결과의 화물 손실률을 상대적으로 줄이는 비율",
      "part_max": 0.1,
      "combined_cap": 0.5,
      "formula": "effective_loss_fraction = base_loss_fraction * (1 - min(0.5, helm.secondary_effects.bad_event_loss_reduction + capped_crew.repair_after_loss))",
      "current_scope": "06_pirates.json의 일반 해적 패배에 따른 현재 적재 화물 손실만",
      "remaining_formula": "floor(current_onboard_quantity * (1 - effective_loss_fraction))",
      "legacy_flavor_events_have_negative_damage": false,
      "future_negative_events": "새 음수 사건 데이터가 명시적으로 추가될 때만 같은 경감률을 연결한다. 현재 null 사건에 손실을 만들지 않는다.",
      "never_changes": [
        "이미 판매한 짐",
        "특산물 선결제 금액",
        "주민이나 선원의 상태",
        "본편 51~57화의 고정 폭풍 결과"
      ]
    }
  },
